diff --git a/src/callback.h b/src/callback.h
index 35bacce..5b08606 100755
--- a/src/callback.h
+++ b/src/callback.h
@@ -8,7 +8,30 @@ typedef int (*FuncPtr)(NodeObj, NodeObj, int);
 
 // the message_id that is sent in
 // msg_eof marks the end of a stream, it travels the same path as the data
-enum { msg_change=0, msg_update, msg_initialize, msg_send, msg_eof };
+//
+// msg_eoc is the end of the CONNECTION, which is a different fact: eof says
+// the data ran out and the wire is still there (a Reader finishing a file),
+// eoc says the wire itself is gone - the instance on the other end was
+// deleted, the socket closed. A subscriber that keeps anything per-wire
+// drops it on eoc; on eof it just stops expecting data. Appended, so the
+// existing ids do not shift.
+// msg_soc is eoc's other half: the wire was just MADE. Together they let a
+// subscriber maintain its own per-wire bookkeeping from messages alone,
+// instead of being told about the start by one route and never about the end.
+//
+// Neither carries a payload - they are facts about the wire, not values on
+// it - so a handler that only special-cases msg_eof and otherwise reads
+// `data` reads nothing and no-ops (the getters return 0/NULL for a NULL
+// node). That is deliberate: a lifecycle message must not read as an
+// arriving value to the twenty-odd handlers that predate it.
+enum { msg_change=0, msg_update, msg_initialize, msg_send, msg_eof, msg_eoc, msg_soc };
+
+// soc and eoc are facts about the WIRE, so they carry the property itself,
+// the same thing a property's own fan-out passes. A handler that reads a
+// value therefore reads a real one and needs to know nothing about them.
+// Only a handler that acts WITHOUT reading the payload has to ask, because
+// nothing else distinguishes a wire event from traffic for it.
+#define MsgIsLifecycle(m)	((m) == msg_soc || (m) == msg_eoc)
 
