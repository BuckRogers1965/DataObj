+/* Tell everything wired to this instance that the WIRE is ending, not just
+   the data (msg_eoc, callback.h). Without it a subscriber is silently
+   unhooked by the scrub below and never learns, so anything keeping state
+   per wire keeps it forever - pointing at freed memory. The bridge's tap
+   records are the case that found this: an instance destroyed by a script
+   left records whose Target dangled, and the next allocation landing on the
+   same address matched one and dereferenced it.
+
+   Delivered SYNCHRONOUSLY, down the same path a property write fans out on:
+   SndMsg would queue it past the frees below and hand the dispatcher a freed
+   property. MsgFromNode() is the property that ended, which is how a
+   subscriber knows WHICH of its wires this is.
+
+   Only wires with a Callback are told. A wire with none is default delivery
+   - a value copied into the target's property - and there is nothing on that
+   side to release; sending eoc down it would just write the dying value. */
+static void AnnounceEndOfConnection(NodeObj node)
+{
+	NodeObj prop, next;
+
+	if (!node)
+		return;
+
+	prop = GetNextProp(node);
+	while (prop) {
+		next = GetNextSibling(prop);
+
+		if (CmpName(prop, "Subscriber")) {
+			if (GetPropLong(prop, "Callback"))
+				DeliverToSubscriber(prop, msg_eoc, node, node);
+		} else {
+			AnnounceEndOfConnection(prop);	/* properties have properties */
+		}
+
+		prop = next;
+	}
+}
