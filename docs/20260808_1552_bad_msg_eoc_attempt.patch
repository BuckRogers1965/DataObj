index 24612d0..42e2d32 100644
--- a/objects/bridge/bridge.c
+++ b/objects/bridge/bridge.c
@@ -1944,6 +1944,80 @@ static NodeObj Bridge_FindTap(NodeObj bridgeInstance, NodeObj propNode, char *ev
 
 int Bridge_TapEmit(NodeObj owner, NodeObj instance, MsgId message, NodeObj data);
 
+/* the watched property announced msg_eoc: let go of the record. No
+   Disconnect - the property that held the subscription is being freed by
+   whoever is deleting the instance, so there is no wire left to unwire.
+   Keyed by the property node, the same identity Bridge_FindTap matches on. */
+static void Bridge_DropTapForProp(NodeObj bridgeInstance, NodeObj propNode)
+{
+	NodeObj taps = GetPropNode(bridgeInstance, "Taps");
+	NodeObj rec, next;
+	char    dbg[256];
+
+	for (rec = taps ? GetChild(taps) : NULL; rec; rec = next)
+	{
+		next = GetNextSibling(rec);
+		if ((NodeObj) GetPropLong(rec, "PropNode") != propNode)
+			continue;
+
+		snprintf(dbg, sizeof(dbg), "eoc: dropped the tap on '%s'.%s",
+				 GetPropStr(rec, "Instance"), GetPropStr(rec, "Port"));
+		DebugPrint(dbg, __FILE__, __LINE__, WIRE);
+
+		DelSibling(rec);
+		DelNode(rec);
+	}
+}
+
+/* is anything still watching this instance? Asked after a record is dropped,
+   so "no" means the wire that just ended was the last one - which is how the
+   deletion is recognised without counting anything. */
+static int Bridge_AnyTapFor(NodeObj bridgeInstance, NodeObj target)
+{
+	NodeObj taps = GetPropNode(bridgeInstance, "Taps");
+	NodeObj rec;
+
+	for (rec = taps ? GetChild(taps) : NULL; rec; rec = GetNextSibling(rec))
+		if ((NodeObj) GetPropLong(rec, "Target") == target)
+			return 1;
+
+	return 0;
+}
+
+/* an instance died by a route the bridge never saw (a script's destroy, a
+   widget tearing down its own children) and the client is still drawing it.
+   Same event Bridge_Delete sends, same container scope: the client has one
+   truth for "it is gone" and does not care who removed it. */
+static void Bridge_AnnounceRemoved(NodeObj owner, char *path)
+{
+	InstanceData *local = (InstanceData *) GetPropLong(owner, "local");
+	char  buf[ALIASLEN + 64], cont[ALIASLEN], *escPath, *slash;
+
+	if (!local || !path || !path[0])
+		return;
+
+	/* the container it lived in - events are scoped by the view the client
+	   has open, and the top view's key is "/Root", never "" */
+	slash = strrchr(path, '/');
+	if (slash && slash != path)
+	{
+		int cut = (int) (slash - path);
+
+		if (cut >= (int) sizeof(cont))
+			cut = (int) sizeof(cont) - 1;
+		memcpy(cont, path, cut);
+		cont[cut] = 0;
+	}
+	else
+		snprintf(cont, sizeof(cont), "/Root");
+
+	escPath = JsonEscapeStr(path);
+	snprintf(buf, sizeof(buf), "{\"event\":\"instance-removed\",\"instance\":%s}", escPath);
+	free(escPath);
+
+	Bridge_SendEventScoped(owner, local, buf, cont);
+}
