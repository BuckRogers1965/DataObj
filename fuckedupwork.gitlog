diff --git a/web/style.css b/web/style.css
index 15f0fbb..868ee1c 100644
--- a/web/style.css
+++ b/web/style.css
@@ -258,6 +258,36 @@ svg.view-wires {
 /* there are NO port dots: the icon itself is the wire target, clicked in  */
 /* Connect mode exactly like any control (registerCard's icon handler)      */
 
+/* ...with ONE exception, and only on a view: a view that named a stand-in  */
+/* inside itself (ReservedIn/ReservedOut) can be wired at its closed icon,  */
+/* so it shows where. In on the left, out on the right. The dot EXISTS only */
+/* when that property is set - setStandInDot creates and destroys it, it is */
+/* never merely hidden - so a view that named one has one dot and a view    */
+/* that named neither has none. Nothing else in the app grows dots; this is */
+/* not a general in/out affordance.                                          */
+.view-dot {
+  display: none;
+  position: absolute;
+  top: 50%;
+  width: 11px;
+  height: 11px;
+  margin-top: -5.5px;
+  border-radius: 50%;
+  background: #6b9fe6;
+  border: 1px solid #24262e;
+  cursor: pointer;
+  /* above the icon, and the one thing in it that takes the mouse, so the  */
+  /* icon underneath can never swallow the wire gesture                     */
+  z-index: 3;
+  pointer-events: auto;
+}
+.view-dot.in  { left: -6px; }
+.view-dot.out { right: -6px; }
+.view-dot:hover { background: #e6c66b; }
+
+/* wiring clutter outside Connect mode, exactly like .port-row above */
+body.mode-connect .view-dot { display: block; }
+
 /* a widget primitive standing on its own - a control (or a dot, for LED) */
 /* and a label, nothing else: no panel, no header, no ports                */
 .widget-atom {
