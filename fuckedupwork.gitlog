+/*
+ * A View can stand in for one of the things inside it, so a wire can be
+ * dropped on its closed icon instead of opening the panel and hunting for
+ * the right control. Two ordinary properties say which: ReservedIn when
+ * the View is a wire's SINK, ReservedOut when it is the SOURCE. Nothing
+ * about this is a direction ON a property - it answers "which of my
+ * internals stands in for me at each end of a wire", which is a fact
+ * about the View's composition. Views only; no other class looks at it.
+ *
+ * The value is one property naming the inner target. It resolves as a
+ * path (absolute, or relative to the View); if the whole string names an
+ * instance, the caller's own property name passes through to it,
+ * otherwise the last segment is taken as the property and the rest as
+ * the instance. Unset or unresolvable means no redirect - the wire lands
+ * on the View itself, exactly as before.
+ */
+static NodeObj ViewRedirect(NodeObj view, char *which, char **prop,
+							 char *propBuf, int propLen)
+{
+	char *spec, vpath[300], full[640], *slash;
+	NodeObj inst;
+
+	/* "is this a view" is GetMainView's question, not a class-name test:
+	   a view is a container for controls, and Reader/Writer/TCPPort are
+	   exactly that - they took on the view machinery (X/Y, a panel, rows
+	   of controls) even though their class is named for what they do. */
+	if (!view || !GetMainView(view))
+		return NULL;
+
+	spec = GetPropStr(view, which);
+	if (!spec || !spec[0])
+		return NULL;
+
+	if (spec[0] == '/')
+		snprintf(full, sizeof(full), "%s", spec);
+	else if (PathOfInstance(view, vpath, sizeof(vpath)))
+		snprintf(full, sizeof(full), "%s/%s", vpath, spec);
+	else
+		return NULL;
+
+	/* the whole thing names an instance - keep the caller's property */
+	inst = ResolvePath(full);
+	if (inst)
+		return inst;
+
+	/* otherwise the last segment is the property on the instance before it */
+	slash = strrchr(full, '/');
+	if (!slash || slash == full)
+		return NULL;
+	*slash = '\0';
+	inst = ResolvePath(full);
+	if (!inst)
+		return NULL;
+	/* the property name is copied out: `full` is this frame's own buffer  */
+	/* and dies on return, so handing back a pointer into it would dangle  */
+	if (prop && propBuf)
+	{
+		snprintf(propBuf, propLen, "%s", slash + 1);
+		*prop = propBuf;
+	}
+	return inst;
+}
+
 int
 Connect(NodeObj fromNode, char * from, NodeObj toNode, char * to){
 
-	NodeObj fromPort, toPort, fromOwner, toOwner;
+	NodeObj fromPort, toPort, fromOwner, toOwner, redirect;
+	char fromPropBuf[128], toPropBuf[128];
 	long handler;
 
 	if (!fromNode || !from || !toNode || !to)
 		return 0;
 
+	/* stand-in resolution happens before anything else, so everything    */
+	/* downstream - the Subscriber record, the graph walkers, Disconnect  */
+	/* - sees the real endpoints and nothing has to know a View was ever  */
+	/* involved                                                            */
+	redirect = ViewRedirect(fromNode, "ReservedOut", &from, fromPropBuf, sizeof(fromPropBuf));
+	if (redirect)
+		fromNode = redirect;
+	redirect = ViewRedirect(toNode, "ReservedIn", &to, toPropBuf, sizeof(toPropBuf));
+	if (redirect)
+		toNode = redirect;
+
 	/* both ends resolve through links: wiring to or from an alias IS   */
 	/* wiring to or from the original - the Subscriber entry lands on    */
 	/* the original's port and carries the original instance, so the     */
@@ -2360,7 +2419,13 @@ Connect(NodeObj fromNode, char * from, NodeObj toNode, char * to){
 	toOwner = toNode;
 	toPort = ResolvePort(&toOwner, to);
 	if (!toPort) {
-		DebugPrint ( "Connect could not find the input port on the sink.", __FILE__, __LINE__, ERROR);
+		char dbg[400], tpath[300];
+
+		snprintf(dbg, sizeof(dbg), "Connect: '%s' has no property '%s'",
+				 PathOfInstance(toNode, tpath, sizeof(tpath)) ? tpath
+					: (GetPropStr(toNode, "Name") ? GetPropStr(toNode, "Name") : "(unnamed)"),
+				 to);
+		DebugPrint(dbg, __FILE__, __LINE__, ERROR);
 		return 0;
 	}
 
