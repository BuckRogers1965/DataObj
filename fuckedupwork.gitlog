diff --git a/testharness/connectiontest.py b/testharness/connectiontest.py
index bee9d97..8eef9dd 100644
--- a/testharness/connectiontest.py
+++ b/testharness/connectiontest.py
@@ -228,6 +228,76 @@ def test_chained_wires(raw, r, home):
              drives(raw, a, c, "62"))
 
 
+def test_view_stand_in(raw, r, home):
+    """ReservedIn/ReservedOut: a View can stand in for one of the controls
+    inside it, so a wire can be dropped on its closed ICON instead of
+    opening the panel to hunt for the control. Connect() (object.c) does
+    the redirect, so the real subscription lands on the inner control and
+    every graph walker - list-connections, clone, Disconnect - sees the
+    true endpoints. The View is never itself an endpoint.
+
+    Guards the mechanism that was asked for a month before it existed and
+    got replaced by an invented in/out "Direction" on every property of
+    every class instead. Nothing here is a direction ON a property: it
+    answers which internal stands in for the View at each END OF A WIRE,
+    which is a fact about the View's composition."""
+    view  = group_view(raw, home, "StandIn")
+    inner = make_slider(raw, view, 10, 10)
+    src   = make_slider(raw, home, 20, 140)
+    sink  = make_slider(raw, home, 20, 200)
+    if not (inner and src and sink):
+        r.expect("view stand-in: fixtures built", "view + 3 sliders",
+                 "inner=%s src=%s sink=%s" % (inner, src, sink), False)
+        return
+    leaf = inner.rsplit("/", 1)[1]
+
+    # --- ReservedIn: wiring TO the view lands on the inner control -------
+    raw.send({"cmd": "set-property", "instance": view,
+              "prop": "ReservedIn", "value": leaf + "/Value"})
+    raw.send({"cmd": "connect", "from": src, "fromPort": "Value",
+              "to": view, "toPort": "Value"})
+
+    wires = [w for w in connections(raw) if w[0] == src]
+    r.expect("ReservedIn: the wire lands on the inner control, not the View",
+             "(%s, Value, %s, Value) - the View is not an endpoint" % (src, inner),
+             "wires from %s: %s" % (src, wires),
+             (src, "Value", inner, "Value") in wires)
+
+    r.expect("ReservedIn: it actually drives the inner control",
+             "writing %s.Value moves %s.Value" % (src, inner),
+             "driven: %s" % drives(raw, src, inner, "61"),
+             drives(raw, src, inner, "62"))
+
+    # --- ReservedOut: wiring FROM the view sources from the control ------
+    raw.send({"cmd": "set-property", "instance": view,
+              "prop": "ReservedOut", "value": leaf + "/Value"})
+    raw.send({"cmd": "connect", "from": view, "fromPort": "Value",
+              "to": sink, "toPort": "Value"})
+
+    wires = [w for w in connections(raw) if w[2] == sink]
+    r.expect("ReservedOut: the wire sources from the inner control",
+             "(%s, Value, %s, Value) - the View is not an endpoint" % (inner, sink),
+             "wires into %s: %s" % (sink, wires),
+             (inner, "Value", sink, "Value") in wires)
+
+    r.expect("ReservedOut: it actually drives from the inner control",
+             "writing %s.Value moves %s.Value" % (inner, sink),
+             "driven: %s" % drives(raw, inner, sink, "71"),
+             drives(raw, inner, sink, "72"))
+
+    # --- unset means no redirect: the View is an ordinary endpoint -------
+    plain = group_view(raw, home, "NoStandIn")
+    raw.send({"cmd": "connect", "from": src, "fromPort": "Value",
+              "to": plain, "toPort": "Value"})
+    wires = [w for w in connections(raw) if w[0] == src and w[2] == plain]
+    r.expect("no ReservedIn: the View is an ordinary endpoint",
+             "(%s, Value, %s, Value) - unset means no redirect at all" % (src, plain),
+             "wires from %s to %s: %s" % (src, plain, wires),
+             (src, "Value", plain, "Value") in wires)
+    close_group(raw, plain)
+    close_group(raw, view)
+
+
 def main():
     ap = argparse.ArgumentParser()
     ap.add_argument("--host", default="127.0.0.1")
@@ -267,6 +337,10 @@ def main():
     test_chained_wires(raw, r, g)
     close_group(raw, g)
 
+    g = group_view(raw, home, "ViewStandIn")
+    test_view_stand_in(raw, r, g)
+    close_group(raw, g)
+
     raw.close()
     sys.exit(1 if r.summary() else 0)
 
diff --git a/web/app.js b/web/app.js
index 23cc1fe..26439c3 100644
--- a/web/app.js
+++ b/web/app.js
@@ -54,7 +54,7 @@ const DISPLAY_WIDGET_CLASS = { [PROP_LED]: 'LED', [PROP_TEXTOUT]: 'TextOut', [PR
 const READOUT_WIDGET_CLASSES = new Set(Object.values(DISPLAY_WIDGET_CLASS));
 
 let ws = null;
-let classes = {};          // className -> [{Name,Direction,Widget,Default}, ...]
+let classes = {};          // className -> [{Name,Widget,Default}, ...]
 let instances = {};        // alias -> {className, el, ports: {name: dotEl}}
 let selfDisplays = {};     // "alias.propName" -> {el,widgetClass}, for a widget class's own State shown on itself
 let liveControls = {};     // "alias.propName" -> {el,widgetClass}, an editable control synced from its own property-changed events
@@ -322,7 +322,8 @@ function handleEvent(msg) {
