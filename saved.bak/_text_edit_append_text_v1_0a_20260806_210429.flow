{"class":"MCPAgent","name":"MCPAgent","props":{"ReservedViewResizeable":"0","Source":"local inputs = {'whole_text','part_text'}\nlocal outputs = {'whole_text'}\nlocal function extract(json, name)\n  local s = json:find('\"' .. name .. '\":\"', 1, true)\n  if not s then return '' end\n  local rest = json:sub(s + #name + 4)\n  local v = rest:match('^([^\"]*)\"')\n  return v or ''\nend\nlocal function esc(s)\n  s = tostring(s or '')\n  s = s:gsub('\\\\', '\\\\\\\\')\n  s = s:gsub('\"', '\\\\\"')\n  s = s:gsub('\\n', '\\\\n')\n  return s\nend\noninput(function(value, kind)\n  log('oninput fired: kind=' .. tostring(kind) .. ' value=' .. tostring(value))\n  if kind == 'eof' then return end\n  if value:sub(1,1) == '{' then\n    for _, name in ipairs(outputs) do\n      sibset(name, extract(value, name))\n    end\n    return\n  end\n  if value ~= '1' then return end\n  local parts = {}\n  for _, name in ipairs(inputs) do\n    table.insert(parts, '\"' .. name .. '\":\"' .. esc(sibget(name)) .. '\"')\n  end\n  send('{' .. table.concat(parts, ',') .. '}')\nend)\n","LastMember":"Submit","ConnectorPath":"/Root/Palette/MCPSource","AgentName":"/text/edit/append_text/v1.0","InnerUp":"","InnerRx":"","ScriptEvt":"","Submit":"","Exec":"","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"1","Name":"_text_edit_append_text_v1_0","Deletable":"1","Container":"/Root/Palette/MCPAgents","H":"276","W":"320","Y":"8","X":"0"},"wires":[],"children":[{"class":"MoButton","name":"MoButton","props":{"LabelPos":"0","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"Submit","Deletable":"1","Container":"","H":"20","W":"60","Y":"166","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Interval":"0","Value":"0","Label":"Submit"},"wires":[{"from":"Value","to":"","port":"Submit"}],"children":[]},{"class":"Textbox","name":"Textbox","props":{"LabelPos":"top","Label":"part_text","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"part_text","Deletable":"1","Container":"","H":"48","W":"220","Y":"108","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"b"},"wires":[],"children":[]},{"class":"Textbox","name":"Textbox","props":{"LabelPos":"top","Label":"whole_text","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"whole_text","Deletable":"1","Container":"","H":"48","W":"220","Y":"50","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"abbbbbb"},"wires":[],"children":[]},{"class":"TextOut","name":"TextOut","props":{"LabelPos":"0","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"Help","Deletable":"1","Container":"","H":"30","W":"260","Y":"8","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"accumulate the text, like building a chapter by parts."},"wires":[],"children":[]}]}