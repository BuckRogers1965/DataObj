{"class":"MCPAgent","name":"MCPAgent","props":{"AgentName":"/text/edit/append_text/v1.0","ConnectorPath":"/Root/Palette/MCPSource","LastMember":"/Root/Palette/MCPAgents/_text_edit_append_text_v1_0/_text_edit_append_text_v1_0Panel_1","Source":"  var inputs  = ['whole_text', 'part_text'];\n  var outputs = ['whole_text'];        // <- your agent's output box names\n  \n  oninput(function (value, kind) {\n      log('oninput fired: kind=' + kind + ' value=' + value);\n      if (kind === 'eof') return;\n      \n      /* a reply came back - fan its fields out to the output boxes */\n      if (String(value).charAt(0) === '{') {\n          var reply = JSON.parse(value);\n          outputs.forEach(function (name) {\n              var v = reply[name]; \n              sibset(name, (v === undefined || v === null) ? '' : String(v));\n          }); \n          return;\n      }   \n      \n      /* Submit sends '1' on press and '0' on release */\n      if (String(value) !== '1') return;\n      \n      var req = {};\n      inputs.forEach(function (name) { req[name] = sibget(name); });\n      send(JSON.stringify(req));\n  }); ","Language":"JSScript","LanguageList":"JSScript,Lua","ReservedViewResizeable":"0","_Internals":"/Root/Palette/MCPAgents/_text_edit_append_text_v1_0/_text_edit_append_text_v1_0Panel_1","InnerUp":"","InnerRx":"","ScriptEvt":"","Submit":"","Exec":"","ReservedViewPanelY":"177","ReservedViewPanelX":"903","ReservedViewOpen":"1","Name":"_text_edit_append_text_v1_1","Deletable":"1","Container":"/Root","H":"276","W":"320","Y":"152","X":"633"},"wires":[],"children":[{"class":"MoButton","name":"MoButton","props":{"LabelPos":"0","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"Submit","Deletable":"1","Container":"","H":"20","W":"60","Y":"166","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Interval":"0","Value":"0","Label":"Submit"},"wires":[{"from":"Value","to":"","port":"Submit"}],"children":[]},{"class":"Textbox","name":"Textbox","props":{"Label":"part_text","LabelPos":"top","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"part_text","Deletable":"1","Container":"","H":"48","W":"220","Y":"108","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"b"},"wires":[],"children":[]},{"class":"Textbox","name":"Textbox","props":{"Label":"whole_text","LabelPos":"top","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"whole_text","Deletable":"1","Container":"","H":"48","W":"220","Y":"50","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"abbbbbbbbbbbb"},"wires":[],"children":[]},{"class":"TextOut","name":"TextOut","props":{"LabelPos":"0","ReservedViewPanelY":"60","ReservedViewPanelX":"240","ReservedViewOpen":"0","Name":"Help","Deletable":"1","Container":"","H":"30","W":"260","Y":"8","X":"10","ReservedOut":"Value","ReservedIn":"Value","Enable":"1","State":"1","Value":"accumulate the text, like building a chapter by parts."},"wires":[],"children":[]}]}